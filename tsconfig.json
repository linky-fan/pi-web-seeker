{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "next.config.ts",
    "proxy.ts",
    "tailwind.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache",
    ".next/server",
    ".next/static",
    ".next/standalone",
    ".pi-web-workspace",
    "**/Application Data",
    "**/Application Data/**",
    "**/Cookies",
    "**/Cookies/**",
    "**/Local Settings",
    "**/Local Settings/**",
    "**/My Documents",
    "**/My Documents/**",
    "**/NetHood",
    "**/NetHood/**",
    "**/PrintHood",
    "**/PrintHood/**",
    "**/Recent",
    "**/Recent/**",
    "**/SendTo",
    "**/SendTo/**",
    "**/Start Menu",
    "**/Start Menu/**",
    "**/Templates",
    "**/Templates/**"
  ]
}
