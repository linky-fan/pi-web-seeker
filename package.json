{
  "name": "@agegr/pi-web",
  "version": "0.6.19",
  "description": "Web UI for the pi coding agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linky-fan/pi-web-seeker.git"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/_events_*",
    "!.next/cache",
    "!.next/dev",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/types",
    "!.next/**/*.js.map",
    "templates/agents",
    "scripts/agents-md.mjs",
    "scripts/coms-net-server.mjs",
    "scripts/model-context-test.mjs",
    "scripts/next-build.mjs",
    "scripts/prepare-github-install.js",
    "pi-packages",
    "next.config.mjs",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -p 30141 -H 0.0.0.0",
    "build": "node scripts/next-build.mjs",
    "start": "next start -p 30141 -H 0.0.0.0",
    "lint": "eslint .",
    "agents": "node scripts/agents-md.mjs",
    "agents:init": "node scripts/agents-md.mjs init",
    "agents:check": "node scripts/agents-md.mjs check",
    "agents:templates": "node scripts/agents-md.mjs templates",
    "coms-net:server": "node scripts/coms-net-server.mjs",
    "test:context": "node scripts/model-context-test.mjs",
    "prepare": "node scripts/prepare-github-install.js",
    "release": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@lobehub/icons": "^5.10.1",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-cookie": "3.0.8",
    "mermaid": "11.15.0"
  }
}
