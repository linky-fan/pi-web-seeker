{
  "name": "@linkyfan/pi-web",
  "version": "0.6.24",
  "description": "Web UI for the pi coding agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linky-fan/pi-web-seeker.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/_events_*",
    "!.next/cache",
    "!.next/dev*",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/types",
    "!.next/**/*.js.map",
    "templates/agents",
    "scripts/agents-md.mjs",
    "scripts/coms-net-server.mjs",
    "scripts/model-context-test.mjs",
    "scripts/next-build.mjs",
    "scripts/patch-pi-ai-stepfun-cache.mjs",
    "scripts/prepare-github-install.js",
    "scripts/release/pack-portable.mjs",
    "pi-packages",
    "next.config.mjs",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -p 30141 -H 0.0.0.0",
    "build": "node scripts/next-build.mjs",
    "start": "next start -p 30141 -H 0.0.0.0",
    "lint": "eslint .",
    "check:fluid-css": "node scripts/check-fluid-css.mjs",
    "agents": "node scripts/agents-md.mjs",
    "agents:init": "node scripts/agents-md.mjs init",
    "agents:check": "node scripts/agents-md.mjs check",
    "agents:templates": "node scripts/agents-md.mjs templates",
    "coms-net:server": "node scripts/coms-net-server.mjs",
    "test:context": "node scripts/model-context-test.mjs",
    "test:remote": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/remote-*.test.mjs",
    "test:app-shell": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/app-shell-state.test.mjs",
    "test:chat-input": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/chat-input-state.test.mjs",
    "test:message-view": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/message-view-state.test.mjs",
    "test:chat-window": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/chat-window-state.test.mjs",
    "test:agent-session": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/agent-session-state.test.mjs",
    "test:extension-ui": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/extension-ui.test.mjs",
    "test:buddy": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/buddy-workflow.test.mjs",
    "test:model-runtime": "node --experimental-strip-types --import ./tests/register-ts-loader.mjs --test tests/model-runtime.test.mjs",
    "pack:portable": "node scripts/release/pack-portable.mjs",
    "postinstall": "node scripts/patch-pi-ai-stepfun-cache.mjs",
    "prepare": "node scripts/prepare-github-install.js",
    "release": "npm run build && npm publish --access public --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "gsap": "^3.15.0",
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.1",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.13"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "dompurify": "3.4.12",
    "eslint-plugin-react-hooks": "7.1.1",
    "js-cookie": "3.0.8",
    "katex": "$katex",
    "mermaid": "11.15.0",
    "protobufjs": "7.6.5"
  }
}
